@page "/admin/reports"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Snackis.Application.Interfaces.Api
@using Snackis.Domain.Entities
@attribute [Authorize(Roles = "Admin")]
@inject IReportServiceApi reportService
@rendermode InteractiveServer
<div class="container mt-5">
    <h2>Admin Dashboard</h2>
    
    <AdminHome />

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5>Reported posts (Reports)</h5>
                @if (Reports.Count > 0)
                {
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Reason</th>
                                <th>Post ID</th>
                                <th>Reported by (User ID)</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var report in Reports)
                            {
                                <tr>
                                    <td><strong>@report.Reason</strong></td>
                                    <td>@report.PostId</td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            @report.Name
                                        </span>
                                    </td>
                                    <td>@report.ReportedAt</td>
                                    <td>@report.IsResolved</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-success me-2" @onclick="() => EditReport(report)">Resolve</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteReport(report.Id)">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No reports.</p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<ApplicationReport> Reports = new();
    private ApplicationReport? selectedReport;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        Reports = await reportService.GetAllReportsAsync();
    }

    private async Task EditReport(ApplicationReport report)
    {
        report.IsResolved = true;
        await reportService.UpdateReportAsync(report);
        Reports = await reportService.GetAllReportsAsync();
    }
    private async Task DeleteReport(int id)
    {
        try
        {
            await reportService.DeleteReportAsync(id);
            await LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting report: {ex.Message}");
        }
    }

}