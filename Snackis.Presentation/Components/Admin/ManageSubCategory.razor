@page "/admin/subcategories"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Snackis.Application.DTOs
@using Snackis.Domain.Entities
@using Snackis.Application.Interfaces.Api

@inject ICategoryServiceApi CategoryServiceApi
@inject ISubCategoryServiceApi SubCategoryServiceApi

<div class="container mt-5">
    <h2>Admin Dashboard</h2>
    
    <AdminHome />

    @if (successMessage != null)
    {
        <div class="alert alert-success">@successMessage</div>
    }
    @if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="row">
        @* New Sub-Category *@
        <div class="col-md-4">
            <div class="card mb-4 shadow-sm">
                <div class="card-body">
                    <h5>New/Edit Sub-Category</h5>
                    
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" @bind="currentSubCategory.Name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" @bind="currentSubCategory.Description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select class="form-control" @bind="currentSubCategory.CategoryId">
                            <option value="0">Choose category</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                    
                    <button class="btn btn-success" @onclick="Submit">
                        Save
                    </button>
                    <button class="btn btn-secondary ms-2" @onclick="ResetForm">
                        Clear
                    </button>
                </div>
            </div>
        </div>
        @* Edit Sub-Categories *@
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Existing sub-categories</h5>
                    @if (subCategories.Count > 0)
                    {
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Description</th>
                                    <th>Category</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subCat in subCategories)
                                {
                                    <tr>
                                        <td><strong>@subCat.Name</strong></td>
                                        <td>@subCat.Description</td>
                                        <td>
                                            <span class="badge bg-secondary">
                                                @GetCategoryName(subCat.CategoryId)
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditSubCategory(subCat)">Edit</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSubCategory(subCat.Id)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No sub-categories found.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>