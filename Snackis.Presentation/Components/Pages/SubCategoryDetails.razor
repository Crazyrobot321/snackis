@page "/sub/{CatId}"
@rendermode InteractiveServer
@using Snackis.Application.Interfaces.Api
@using Snackis.Application.Services
@using Snackis.Domain.Entities

@inject ITopicServiceApi TopicServiceApi
@inject ISubCategoryServiceApi SubCategoryServiceApi
@inject BlobStorageService blobStorageService
@inject AuthenticationStateProvider AuthenticationStateProvider

<AuthorizeView Roles="Admin, User">
    <Authorized>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>General Discussion</h2>
            <button class="btn btn-primary btn-sm" @onclick="OpenNewTopicForm">New Topic</button>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="alert alert-warning mb-4">
            <h5>Oops, sign in dingus</h5>
            <p class="mb-0 small">You need to be logged in to create new topics.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

<div class="list-group shadow-sm">
    @if (Topics != null && Topics.Count > 0)
    {
        @foreach (var topic in Topics)
        {
            <p>AuthorId: @topic.AuthorId | CurrentUserId: @currentUserId</p>
            <div class="list-group-item list-group-item-action py-3">
                @if (editingTopicId == topic.Id)
                {
                    <div class="mb-2">
                        <input class="form-control mb-2" @bind="editTopicTitle" placeholder="Title" />
                        <textarea class="form-control mb-2" @bind="editTopicContent" rows="3"></textarea>
                        <div class="d-flex gap-2">
                            <button class="btn btn-success btn-sm" @onclick="SaveEdit">Save</button>
                            <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1">
                                <a href="/topic/@topic.Id" class="text-decoration-none text-dark fw-bold">@topic.Title</a>
                            </h6>
                            <div class="text-muted small">
                                <span>Started by <strong>@topic.AuthorName</strong></span>
                                <span> On <strong>@topic.Created?.ToString("yyyy-MM-dd")</strong></span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary rounded-pill">@topic.PostCount</span>
                            @if (topic.AuthorId == currentUserId)
                            {
                                <button class="btn btn-outline-secondary btn-sm" @onclick="() => EditTopic(topic)">Edit</button>
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteTopic(topic.Id)">Delete</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">No topics available in this category.</div>
    }
</div>

@if (showNewTopicForm)
{
    <div class="modal d-block" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Topic</h5>
                    <button type="button" class="btn-close" @onclick="CloseNewTopicForm"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="topicTitle" class="form-label">Title</label>
                        <input type="text" class="form-control" id="topicTitle" @bind="newTopicTitle" placeholder="Enter topic title">
                    </div>
                    <div class="mb-3">
                        <label for="topicContent" class="form-label">Content</label>
                        <textarea class="form-control" id="topicContent" @bind="newTopicContent" rows="4" placeholder="Enter topic content"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="topicImage" class="form-label">Image</label>
                        <InputFile id="topicImage" class="form-control" OnChange="OnImageSelected" accept="image/*" />
                        @if (selectedImage != null)
                        {
                            <small class="text-muted">@selectedImage.Name selected</small>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseNewTopicForm">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitNewTopic">Create Topic</button>
                    @if (errorMessage != null)
                    {
                        <div class="alert alert-danger mt-2">@errorMessage</div>
                    }
                </div>
            </div>
        </div>
    </div>
}