@using Snackis.Domain.Entities
<div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
    <div>
        <h6 class="mb-1">
            <a href="/topic/@topic.Id" class="text-decoration-none text-dark fw-bold">@topic.Title</a>
        </h6>
        <div class="text-muted small">
            <span>Started by <strong>@topic.AuthorName</strong></span>
            <span> On <strong>@topic.Created?.ToString("yyyy-MM-dd")</strong></span>
        </div>
    </div>
    <span class="badge bg-secondary rounded-pill">@((topic.Posts?.Count ?? 0))</span>
</div>

@code {
    [Parameter]
    public ApplicationTopic topic { get; set; } = default!;
}
