@using Snackis.Domain.Entities
<a href="/sub/@SubCategories.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
    <div>
        <h6 class="mb-1 text-decoration-none text-dark fw-bold">@SubCategories.Name</h6>
        <div class="text-muted small">
            <span><strong>@SubCategories.Description</strong></span>
        </div>
    </div>
    <span class="badge bg-secondary rounded-pill">@SubCategories.TopicCount</span>
</a>

@code {
    [Parameter]
    public ApplicationSubCategory SubCategories { get; set; } = default!;
}
